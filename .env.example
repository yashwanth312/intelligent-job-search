# Copy to .env and fill in. .env is gitignored. Full guide: README.md

# ── Google ──────────────────────────────────────────────────────────────
# Service-account key file (see README step "Google Sheets").
GOOGLE_SHEETS_CREDS_FILE=credentials.json
# Name of YOUR spreadsheet. Create it yourself in Google Sheets and share it
# (Editor) with the service account's client_email.
SPREADSHEET_NAME=Intelligent Job Search
# Optional: Drive folder ID for uploaded PDFs. Leave EMPTY to keep PDFs in
# ./output/ only (recommended to start).
GOOGLE_DRIVE_FOLDER_ID=

# ── Your details (printed in the resume header) ─────────────────────────
# Keep these consistent with personal: in profile.yaml.
YOUR_NAME=Your Full Name
YOUR_EMAIL=you@example.com
YOUR_PHONE=+1 (555) 000 0000
YOUR_LOCATION_FALLBACK=City, State
YOUR_LINKEDIN=linkedin.com/in/your-handle
YOUR_GITHUB=github.com/your-handle

# ── Search behaviour (all optional; defaults shown) ─────────────────────
# Set true ONLY if you need an employer to sponsor a work visa: drops
# employers with no DOL H-1B filing history and JDs that refuse sponsorship.
SPONSORSHIP_FILTER_ENABLED=false
# A JD requiring this many years or more is dropped in Stage 1 (99 = never).
MIN_YOE_HARD_STOP=4
# How Stage 2 describes the level you want.
TARGET_LEVEL=0-3 years / junior-to-mid
# Drop jobs whose stated max salary is below this (0 = off).
SALARY_FLOOR=0

# ── Paths (optional) ────────────────────────────────────────────────────
# Full path to the Claude CLI if `claude` is not on PATH.
# CLAUDE_CLI=
# Root used for file paths written to the Materials tab (default: this repo).
# USER_LAPTOP_REPO_PATH=
